# ==============================================================================
# IONOS Apache Web Server Configuration - Shams Consult (Pre-rendered Static Site)
# ==============================================================================

DirectoryIndex index.html

# Prevent automatic directory listings and unwanted trailing-slash redirect chains
Options -Indexes
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

# Serve real HTTP 404 header and static page for non-existent routes (eliminates Soft 404s)
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Collapse multiple consecutive slashes (e.g. //leistungen -> /leistungen)
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s//+([^\s]*) [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 2. Force HTTPS & Non-WWW (consolidates canonical host into a single 301 hop)
  RewriteCond %{HTTP_HOST} ^www\.shams-consult\.de$ [NC,OR]
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://shams-consult.de/$1 [R=301,L]

  # ----------------------------------------------------------------------------
  # 2b. Legacy URLs 301 Redirects to Modern Canonical URLs (Single Hop UX)
  # ----------------------------------------------------------------------------
  # Blog: Tipps für die wirtschaftliche Umsetzung nachhaltiger Projekte
  RewriteCond %{REQUEST_URI} ^/+(?:tipps.*wirtschaftliche.*) [NC]
  RewriteRule ^ https://shams-consult.de/blog/wirtschaftliche-umsetzung-nachhaltiger-projekte [R=301,L]

  # Blog: Flächeneffizienz und soziale Nachhaltigkeit
  RewriteCond %{REQUEST_URI} ^/+(?:fl.*cheneffizienz.*soziale.*) [NC]
  RewriteRule ^ https://shams-consult.de/blog/flaecheneffizienz-soziale-nachhaltigkeit [R=301,L]

  # Blog: Nachhaltigkeit beginnt lange vor dem ersten Spatenstich
  RewriteCond %{REQUEST_URI} ^/+(?:nachhaltigkeit-beginnt.*spatenstich.*) [NC]
  RewriteRule ^ https://shams-consult.de/blog/nachhaltigkeit-beginnt-vor-dem-spatenstich [R=301,L]

  # Blog: Energieeffizienz in der Praxis – mehr als nur Dämmung
  RewriteCond %{REQUEST_URI} ^/+(?:energieeffizienz-in-der-praxis.*) [NC]
  RewriteRule ^ https://shams-consult.de/blog/energieeffizienz-in-der-praxis [R=301,L]

  # Blog: Materialien mit Verantwortung – Baustoffe der Zukunft
  RewriteCond %{REQUEST_URI} ^/+(?:materialien-mit-verantwortung.*) [NC]
  RewriteRule ^ https://shams-consult.de/blog/materialien-mit-verantwortung [R=301,L]

  # Blog: Reduktion in der Architektur – Klarheit, die wirkt
  RewriteCond %{REQUEST_URI} ^/+(?:reduktion-in-der-architektur.*) [NC]
  RewriteRule ^ https://shams-consult.de/blog/reduktion-in-der-architektur [R=301,L]

  # Blog: Wie Architektur Emotionen auslöst / Raum wirkt
  RewriteCond %{REQUEST_URI} ^/+(?:wie-architektur-emotionen.*) [NC]
  RewriteRule ^ https://shams-consult.de/blog/raum-wirkt [R=301,L]

  # Blog: Nachhaltig planen – der Schlüssel liegt im Entwurf
  RewriteCond %{REQUEST_URI} ^/+(?:nachhaltig-planen.*) [NC]
  RewriteRule ^ https://shams-consult.de/blog/nachhaltig-planen [R=301,L]

  # Blog: Material spricht, wenn man es lässt
  RewriteCond %{REQUEST_URI} ^/+(?:material-spricht.*) [NC]
  RewriteRule ^ https://shams-consult.de/blog/material-spricht [R=301,L]

  # Blog: Licht als Entwurfspartner
  RewriteCond %{REQUEST_URI} ^/+(?:licht-als-entwurfspartner.*) [NC]
  RewriteRule ^ https://shams-consult.de/blog/licht-als-entwurfspartner [R=301,L]

  # Blog: Proportion, Rhythmus, Maßstab
  RewriteCond %{REQUEST_URI} ^/+(?:proportion-rhythmus-ma.*stab.*) [NC]
  RewriteRule ^ https://shams-consult.de/blog/proportion-rhythmus-massstab [R=301,L]

  # Blog: Was wir unter guter Gestaltung verstehen
  RewriteCond %{REQUEST_URI} ^/+(?:was-wir-unter-guter-gestaltung.*) [NC]
  RewriteRule ^ https://shams-consult.de/blog/was-wir-unter-guter-gestaltung-verstehen [R=301,L]

  # QNG / Qualitätssiegel Nachhaltiges Gebäude / Bauen
  RewriteCond %{REQUEST_URI} ^/+(?:qualit.*tssiegel.*nachhaltiges.*) [NC]
  RewriteRule ^ https://shams-consult.de/project/qs-nachhaltiges-gebaeude-goetzenhain [R=301,L]

  # Legacy vCard file downloads (redirects legacy Jimdo & aliases to canonical majeed-shams.vcf)
  RewriteCond %{REQUEST_URI} !^/+majeed-shams\.vcf$ [NC]
  RewriteCond %{REQUEST_URI} ^/+(?:.*Planungsb.*ro.*Shams.*Consult.*\.vcf|.*shams-consult\.vcf|app/download/12468669157/.*) [NC]
  RewriteRule ^ https://shams-consult.de/majeed-shams.vcf [R=301,L]

  # Digital Business Card & vCard Page Aliases
  RewriteCond %{REQUEST_URI} ^/+(?:vcard|visitenkarte|kontaktkarte|contact-card)/?$ [NC]
  RewriteRule ^ https://shams-consult.de/card [R=301,L]

  # Legacy app download files -> /contact
  RewriteCond %{REQUEST_URI} ^/+(?:app/download/.*) [NC]
  RewriteRule ^ https://shams-consult.de/contact [R=301,L]


  # Services: Digitalisierungsberatung
  RewriteCond %{REQUEST_URI} ^/+(?:digitalisierungsberatung.*) [NC]
  RewriteRule ^ https://shams-consult.de/services [R=301,L]

  # Services: Stadtplanung & Städtebau (strictly matched to not interfere with /stadtplanung-hessen)
  RewriteCond %{REQUEST_URI} ^/+(?:stadtplanung|stadtplanung-st[^\/]*tebau)/?$ [NC]
  RewriteRule ^ https://shams-consult.de/services [R=301,L]

  # Services: Vorhabenbezogene Bebauungspläne
  RewriteCond %{REQUEST_URI} ^/+(?:vorhabenbezogene-bebauungspl.*) [NC]
  RewriteRule ^ https://shams-consult.de/services [R=301,L]

  # Projects: Spital Günzburg (matches with or without /project/)
  RewriteCond %{REQUEST_URI} ^/+(?:project/)?vep-spital-guenzburg.* [NC]
  RewriteRule ^ https://shams-consult.de/project/vep-alten-und-pflegeheim-guenzburg [R=301,L]

  # Projects: Töpfenmühle Gersfeld (matches with or without /project/)
  RewriteCond %{REQUEST_URI} ^/+(?:project/)?vep-toepfenmuehle-gersfeld.* [NC]
  RewriteRule ^ https://shams-consult.de/project/bebauungsplan-toepfenmuehle-gersfeld [R=301,L]

  # Projects: Baufeld 5 Neu-Ulm (matches with or without /project/)
  RewriteCond %{REQUEST_URI} ^/+(?:project/)?vep-baufeld-5-neu-ulm.* [NC]
  RewriteRule ^ https://shams-consult.de/project/bebauungsplan-neu-ulm-baufeld-5-ost [R=301,L]

  # Projects: Mehrfamilienhaus Dreieich-Götzenhain (without /project/)
  RewriteCond %{REQUEST_URI} ^/+mehrfamilienhaus-dreieich-goetzenhain.* [NC]
  RewriteRule ^ https://shams-consult.de/project/mehrfamilienhaus-dreieich-goetzenhain [R=301,L]

  # Projects: Einfamilienhaus Lingen (Ems) (without /project/)
  RewriteCond %{REQUEST_URI} ^/+einfamilienhaus-lingen-ems.* [NC]
  RewriteRule ^ https://shams-consult.de/project/einfamilienhaus-lingen-ems [R=301,L]

  # Projects: Kindergarten Schemmerhofen (without /project/)
  RewriteCond %{REQUEST_URI} ^/+kindergarten-schemmerhofen.* [NC]
  RewriteRule ^ https://shams-consult.de/project/kindergarten-schemmerhofen [R=301,L]

  # Projects: QS Nachhaltiges Gebäude Götzenhain (without /project/)
  RewriteCond %{REQUEST_URI} ^/+qs-nachhaltiges-gebaeude-goetzenhain.* [NC]
  RewriteRule ^ https://shams-consult.de/project/qs-nachhaltiges-gebaeude-goetzenhain [R=301,L]

  # Legacy CMS & Moderation routes
  RewriteCond %{REQUEST_URI} ^/+(?:auth|moderation)(?:/.*)?$ [NC]
  RewriteRule ^ https://shams-consult.de/founder-portal [R=301,L]

  # Legacy taxonomy & blog categories
  RewriteCond %{REQUEST_URI} ^/+(?:kategorie|category|tag|tags)(?:/.*)?$ [NC]
  RewriteRule ^ https://shams-consult.de/blog [R=301,L]

  # ----------------------------------------------------------------------------
  # 2c. Complete 301 Redirects for Aliases to Canonical Routes (Single Hop UX)
  # ----------------------------------------------------------------------------
  # Contact aliases
  RewriteRule ^en/(?:kontakt|beratung|termin)(?:\.html)?/?$ https://shams-consult.de/en/contact [R=301,L,NC]
  RewriteRule ^(?:kontakt|beratung|termin)(?:\.html)?/?$ https://shams-consult.de/contact [R=301,L,NC]

  # Services aliases (strictly delimited to avoid affecting /architektur-frankfurt etc.)
  RewriteRule ^en/(?:leistungen|hoai|architektur)(?:\.html)?/?$ https://shams-consult.de/en/services [R=301,L,NC]
  RewriteRule ^(?:leistungen|hoai|architektur)(?:\.html)?/?$ https://shams-consult.de/services [R=301,L,NC]

  # Dynamic Projects aliases (/projekt/slug, /projekte/slug -> /project/slug)
  RewriteRule ^en/(?:projekt|projekte)/(.*)$ https://shams-consult.de/en/project/$1 [R=301,L,NC]
  RewriteRule ^(?:projekt|projekte)/(.*)$ https://shams-consult.de/project/$1 [R=301,L,NC]

  # Projects top-level aliases
  RewriteRule ^en/(?:projekte|portfolio|bauten|arbeiten)(?:\.html)?/?$ https://shams-consult.de/en/projects [R=301,L,NC]
  RewriteRule ^(?:projekte|portfolio|bauten|arbeiten)(?:\.html)?/?$ https://shams-consult.de/projects [R=301,L,NC]

  # About aliases
  RewriteRule ^en/(?:buero|b[^\/]*ro|geschichte|philosophie|karriere|kundenfeedback|ueber-uns|[^\/]*ber-uns|wir-ueber-uns|team|profil|agentur)(?:\.html)?/?$ https://shams-consult.de/en/about [R=301,L,NC]
  RewriteRule ^(?:buero|b[^\/]*ro|geschichte|philosophie|karriere|kundenfeedback|ueber-uns|[^\/]*ber-uns|wir-ueber-uns|team|profil|agentur)(?:\.html)?/?$ https://shams-consult.de/about [R=301,L,NC]

  # B2B & Developers aliases
  RewriteRule ^en/(?:bautraeger|bautr[^\/]*ger|investoren|investors|developers|developers-investors|b2b|fcn-kundentag|kundentag|b2b-partner)(?:\.html)?/?$ https://shams-consult.de/en/bautraeger-investoren [R=301,L,NC]
  RewriteRule ^(?:bautraeger|bautr[^\/]*ger|investoren|investors|developers|developers-investors|b2b|fcn-kundentag|kundentag|b2b-partner)(?:\.html)?/?$ https://shams-consult.de/bautraeger-investoren [R=301,L,NC]

  # Founder aliases
  RewriteRule ^en/(?:gruender|gr[^\/]*nder|inhaber|vita|architekt)(?:\.html)?/?$ https://shams-consult.de/en/founder [R=301,L,NC]
  RewriteRule ^(?:gruender|gr[^\/]*nder|inhaber|vita|architekt)(?:\.html)?/?$ https://shams-consult.de/founder [R=301,L,NC]

  # Research aliases
  RewriteRule ^en/(?:forschung|lehre|thesen|publikationen)(?:\.html)?/?$ https://shams-consult.de/en/research [R=301,L,NC]
  RewriteRule ^(?:forschung|lehre|thesen|publikationen)(?:\.html)?/?$ https://shams-consult.de/research [R=301,L,NC]

  # Dynamic Case Study aliases (/fallstudie/id, /referenz/id -> /case-study/id)
  RewriteRule ^en/(?:fallstudie|referenz)/(.*)$ https://shams-consult.de/en/case-study/$1 [R=301,L,NC]
  RewriteRule ^(?:fallstudie|referenz)/(.*)$ https://shams-consult.de/case-study/$1 [R=301,L,NC]

  # Clients & Case Studies top-level aliases
  RewriteRule ^en/(?:kunden|partner|partners|referenzen|auftraggeber|case-studies)(?:\.html)?/?$ https://shams-consult.de/en/clients [R=301,L,NC]
  RewriteRule ^(?:kunden|partner|partners|referenzen|auftraggeber|case-studies)(?:\.html)?/?$ https://shams-consult.de/clients [R=301,L,NC]

  # Site Visits aliases
  RewriteRule ^en/(?:album|einblicke|vor-ort|baustellen)(?:\.html)?/?$ https://shams-consult.de/en/site-visits [R=301,L,NC]
  RewriteRule ^(?:album|einblicke|vor-ort|baustellen)(?:\.html)?/?$ https://shams-consult.de/site-visits [R=301,L,NC]

  # Dynamic Blog aliases (/magazin/slug, /news/slug, /artikel/slug -> /blog/slug)
  RewriteRule ^en/(?:magazin|news|artikel)/(.*)$ https://shams-consult.de/en/blog/$1 [R=301,L,NC]
  RewriteRule ^(?:magazin|news|artikel)/(.*)$ https://shams-consult.de/blog/$1 [R=301,L,NC]

  # Blog top-level aliases
  RewriteRule ^en/(?:magazin|news|aktuelles|artikel|beitraege)(?:\.html)?/?$ https://shams-consult.de/en/blog [R=301,L,NC]
  RewriteRule ^(?:magazin|news|aktuelles|artikel|beitraege)(?:\.html)?/?$ https://shams-consult.de/blog [R=301,L,NC]

  # Comparison short slug aliases (/slug -> /vergleich/slug)
  RewriteRule ^en/(boutique-vs-grossbuero|architekt-oder-bautraeger|vollarchitektur-vs-entwurf)(?:\.html)?/?$ https://shams-consult.de/en/vergleich/$1 [R=301,L,NC]
  RewriteRule ^(boutique-vs-grossbuero|architekt-oder-bautraeger|vollarchitektur-vs-entwurf)(?:\.html)?/?$ https://shams-consult.de/vergleich/$1 [R=301,L,NC]

  # Legal aliases
  RewriteRule ^en/imprint(?:\.html)?/?$ https://shams-consult.de/en/impressum [R=301,L,NC]
  RewriteRule ^imprint(?:\.html)?/?$ https://shams-consult.de/impressum [R=301,L,NC]

  RewriteRule ^en/(?:privacy|datenschutzerklaerung|datenschutzerkl[^\/]*rung)(?:\.html)?/?$ https://shams-consult.de/en/datenschutz [R=301,L,NC]
  RewriteRule ^(?:privacy|datenschutzerklaerung|datenschutzerkl[^\/]*rung)(?:\.html)?/?$ https://shams-consult.de/datenschutz [R=301,L,NC]

  RewriteRule ^en/widerrufsbelehrung(?:\.html)?/?$ https://shams-consult.de/en/widerruf [R=301,L,NC]
  RewriteRule ^widerrufsbelehrung(?:\.html)?/?$ https://shams-consult.de/widerruf [R=301,L,NC]

  RewriteRule ^en/accessibility(?:\.html)?/?$ https://shams-consult.de/en/barrierefreiheit [R=301,L,NC]
  RewriteRule ^accessibility(?:\.html)?/?$ https://shams-consult.de/barrierefreiheit [R=301,L,NC]

  # Blog legacy categories & tags: /blog/design-und-ästhetik -> /blog
  RewriteCond %{REQUEST_URI} ^/+(?:blog/design-und-[^\/]+)/?$ [NC]
  RewriteRule ^ https://shams-consult.de/blog [R=301,L]

  # Blog legacy slug: /blog/nachhaltiges-bauen -> /blog/was-bedeutet-nachhaltiges-bauen
  RewriteCond %{REQUEST_URI} ^/+(?:blog/nachhaltiges-bauen)/?$ [NC]
  RewriteRule ^ https://shams-consult.de/blog/was-bedeutet-nachhaltiges-bauen [R=301,L]

  # ----------------------------------------------------------------------------
  # 2d. Generic .html Strip for Legacy Direct Requests (Single Hop UX)
  # ----------------------------------------------------------------------------
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+(?:index)\.html[\s?] [NC]
  RewriteRule ^ https://shams-consult.de/ [R=301,L]

  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+(?!404\.html)(.+)\.html[\s?] [NC]
  RewriteRule ^ https://shams-consult.de/%1 [R=301,L]

  # 3. Strip trailing slash for pages (except root "/") to match canonical URLs and avoid redirect loops
  RewriteCond %{REQUEST_URI} ^/(.+)/$
  RewriteRule ^/(.+)/$ /$1 [R=301,L]

  # 4. If exact file exists (assets, images, fonts, sitemap.xml, robots.txt), serve directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 5. If directory with index.html exists, internally rewrite to index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 6. Fallback for valid routes without physical directory slash (e.g. /services -> /services/index.html)
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 7. Non-existent routes: trigger real HTTP 404 Not Found
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html !-f
  RewriteRule ^ - [R=404,L]
</IfModule>

# Caching & Performance
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML pages - revalidate quickly
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/xml "access plus 1 day"
  ExpiresByType application/xml "access plus 1 day"

  # Static assets (JS, CSS, Images, Fonts) - long-term cache
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  <FilesMatch "\.vcf$">
    Header set Content-Disposition "attachment; filename=\"Majeed-Shams-Architekt.vcf\""
    Header set Content-Type "text/vcard; charset=utf-8"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType text/vcard .vcf
</IfModule>

# Gzip / Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
